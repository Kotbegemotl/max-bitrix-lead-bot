<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Admin login</title>
  <style>
    body { font-family: Arial; max-width: 420px; margin: 60px auto; }
    input { width: 100%; padding: 10px; margin: 6px 0 14px; }
    button { padding: 10px 16px; }
    .err { color: #b00020; margin-bottom: 12px; }
    .box { border: 1px solid #ddd; padding: 18px; border-radius: 8px; }
  </style>
</head>
<body>
  <div class="box">
    <h2>Вход в админку</h2>
    <% if (error) { %><div class="err"><%= error %></div><% } %>

    <form method="post" action="<%= adminPath %>/login">
      <label>Логин</label>
      <input name="username" autocomplete="username" required />

      <label>Пароль</label>
      <input name="password" type="password" autocomplete="current-password" required />

      <button type="submit">Войти</button>
    </form>
  </div>
</body>
</html>

