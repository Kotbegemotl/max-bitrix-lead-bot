<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>MAX Bot Admin</title>
  <style>
    body { font-family: Arial; margin:40px; }
    .stage { border:1px solid #ccc; padding:15px; margin-bottom:20px; }
    textarea { width:100%; height:80px; }
    input[type=file] { margin-top:5px; }
    button { padding:8px 15px; margin-top:10px; }
  </style>
</head>
<body>
  <h1>MAX Bot Admin</h1>

  <% stages.forEach(stage => { %>
    <div class="stage">
      <h2><%= stage.id %></h2>

      <% stage.messages.forEach((msg, i) => { %>
        <div>
          <b>Сообщение <%= i+1 %></b><br>
          <textarea><%= msg.text %></textarea><br>
          Картинки: <%= msg.images.length %>
        </div>
        <hr>
      <% }) %>
    </div>
  <% }) %>

</body>
</html>

